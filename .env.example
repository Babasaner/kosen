# Copy this file to .env (git-ignored) and fill in real values.
# The server reads .env.local first, then .env, then the host environment.

# Brevo transactional email API key: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Ali's mailbox, where every landing page request is delivered.
BREVO_RECIPIENT_EMAIL=
# Must be a verified sender in the Brevo account, otherwise Brevo rejects the send.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=KOSEN

# Values are trimmed when read, so a stray space is harmless. Copy and paste
# carefully anyway: a key copied half way leaves a 401 "Key not found".
PORT=8787

# Set to true to include the email provider's raw response in the API reply.
# Useful to debug a deployment, must stay off in production: it exposes the
# provider error to the public. Read the detail, then set it back to false.
# LEAD_DIAGNOSTICS=true

# Comma separated list of allowed origins (used for CORS on direct API calls).
# Leave unset when the API is served from the same origin as the page.
# ALLOWED_ORIGINS=http://localhost:5173,https://residences.kosen-project.com

# The literal value "local-dev" allows any localhost/127.0.0.1 origin on any
# port, and any private LAN address (10.x, 172.16-31.x, 192.168.x, *.local).
# Convenient to preview the site on a phone: run "npm run dev", then open
# http://<your-computer-ip>:5173 on the phone. Remove it in production.
# ALLOWED_ORIGINS=local-dev,https://residences.kosen-project.com
